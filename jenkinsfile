
pipeline {
    agent any

    stages {

        stage('SCM') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/gsambikag-star/Jenkins-Experiment-6'
            }
        }

        stage('Build') {
            steps {
                bat 'mvn compile'
            }
        }

        stage('Test') {
            steps {
                bat 'mvn test'
            }
        }

        stage('Package') {
            steps {
                bat 'mvn package'
            }
        }
    }
}
